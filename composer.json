{
  "name": "jacyimp/cloud-ip-detector",
  "description": "Detect which known cloud or infrastructure provider owns an IP address.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "JacyImp"
    }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpbench/phpbench": "^1.7",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "JacyImp\\CloudIpDetector\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JacyImp\\CloudIpDetector\\Benchmarks\\": "benchmarks/",
      "JacyImp\\CloudIpDetector\\Tests\\": "tests/",
      "JacyImp\\CloudIpDetector\\Tools\\": "tools/"
    }
  },
  "scripts": {
    "bench": "phpbench run --report=aggregate",
    "bench:baseline": "phpbench run --tag=baseline --report=aggregate",
    "test": "phpunit",
    "test:coverage": [
      "phpunit --coverage-clover var/coverage.xml",
      "@php tools/assert-full-coverage.php var/coverage.xml"
    ],
    "phpstan": "phpstan analyse",
    "phpcs": "phpcs",
    "update:ranges": "php tools/update-ip-ranges.php",
    "check": [
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
